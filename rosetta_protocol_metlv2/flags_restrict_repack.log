<ROSETTASCRIPTS>
	<SCOREFXNS>
		<ScoreFunction name="beta_sf" weights="beta_nov16_cart"/>
	</SCOREFXNS>
	<RESIDUE_SELECTORS>
		<Neighborhood distance="10" name="surrounding" resnums="55"/>
		<Not name="rest" selector="surrounding"/>
	</RESIDUE_SELECTORS>
	<TASKOPERATIONS>
		<OperateOnResidueSubset name="repack_res" selector="surrounding">
			<RestrictToRepackingRLT/>
		</OperateOnResidueSubset>
		<OperateOnResidueSubset name="no_repack" selector="rest">
			<PreventRepackingRLT/>
		</OperateOnResidueSubset>
	</TASKOPERATIONS>
	<MOVERS>
		<MutateResidue name="mutant" new_res="ALA" target="55A"/>
		<FastRelax cartesian="true" disable_design="false" name="relax" repeats="10" scorefxn="beta_sf" task_operations="repack_res,no_repack"/>
	</MOVERS>
	<PROTOCOLS>
		<Add mover_name="mutant"/>
		<Add mover="relax"/>
	</PROTOCOLS>
	<OUTPUT scorefxn="beta_sf"/>
</ROSETTASCRIPTS>
