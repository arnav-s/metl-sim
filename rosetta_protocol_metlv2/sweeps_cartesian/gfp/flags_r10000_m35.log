<ROSETTASCRIPTS>
	<SCOREFXNS>
		<ScoreFunction name="beta_sf" weights="beta_nov16_cart"/>
	</SCOREFXNS>
	<RESIDUE_SELECTORS>
		<Neighborhood distance="35" name="surrounding_move_map" resnums="55"/>
		<Not name="rest_move_map" selector="surrounding_move_map"/>
		<Neighborhood distance="10000" name="surrounding_repack" resnums="55"/>
		<Not name="rest_repack" selector="surrounding_repack"/>
	</RESIDUE_SELECTORS>
	<TASKOPERATIONS>
		<InitializeFromCommandline name="init"/>
		<OperateOnResidueSubset name="repack_res" selector="surrounding_repack">
			<RestrictToRepackingRLT/>
		</OperateOnResidueSubset>
		<OperateOnResidueSubset name="no_repack" selector="rest_repack">
			<PreventRepackingRLT/>
		</OperateOnResidueSubset>
	</TASKOPERATIONS>
	<MOVE_MAP_FACTORIES>
		<MoveMapFactory bb="0" chi="0" name="local_mm">
			<Backbone enable="true" residue_selector="surrounding_move_map"/>
			<Chi enable="true" residue_selector="surrounding_move_map"/>
		</MoveMapFactory>
	</MOVE_MAP_FACTORIES>
	<MOVERS>
		<MutateResidue name="mutant" new_res="ALA" target="45A"/>
		<FastRelax cartesian="true" disable_design="true" movemap_factory="local_mm" name="relax" repeats="5" scorefxn="beta_sf" task_operations="init,repack_res,no_repack"/>
	</MOVERS>
	<PROTOCOLS>
		<Add mover_name="mutant"/>
		<Add mover_name="relax"/>
	</PROTOCOLS>
	<OUTPUT scorefxn="beta_sf"/>
</ROSETTASCRIPTS>
