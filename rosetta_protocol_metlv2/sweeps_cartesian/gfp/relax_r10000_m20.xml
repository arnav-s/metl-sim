<ROSETTASCRIPTS>
  <SCOREFXNS>
    <ScoreFunction name="beta_sf" weights="beta_nov16_cart"/>
  </SCOREFXNS>

  <RESIDUE_SELECTORS>
    <Neighborhood name="surrounding_move_map" resnums="55" distance="20"/>
    <Not name="rest_move_map" selector="surrounding_move_map"/>

    <Neighborhood name="surrounding_repack" resnums="55" distance="10000"/>
    <Not name="rest_repack" selector="surrounding_repack"/>

  </RESIDUE_SELECTORS>




  <TASKOPERATIONS>
    <InitializeFromCommandline name="init"/>

    <OperateOnResidueSubset name="repack_res" selector="surrounding_repack">
      <RestrictToRepackingRLT/>
    </OperateOnResidueSubset>
    <OperateOnResidueSubset name="no_repack" selector="rest_repack">
      <PreventRepackingRLT/>
    </OperateOnResidueSubset>
  </TASKOPERATIONS>



  <MOVE_MAP_FACTORIES>
    <!-- allow backbone and sidechain minimization only for residues in "surrounding" -->
    <MoveMapFactory name="local_mm" bb="0" chi="0">
      <Backbone residue_selector="surrounding_move_map" enable="true"/>
      <Chi residue_selector="surrounding_move_map" enable="true"/>
    </MoveMapFactory>
  </MOVE_MAP_FACTORIES>



  <MOVERS>
    <!-- take residue 55 in chain A and mutate it to an Alanine (A)-->

    <MutateResidue name="mutant" target="45A" new_res="ALA"/>
    <FastRelax name="relax"
               scorefxn="beta_sf"
               disable_design="true"
               task_operations="init,repack_res,no_repack"
               repeats="5"
               cartesian="true"
               movemap_factory="local_mm"/>
  </MOVERS>

  <PROTOCOLS>
    <!-- make sure to add a new mover for each new mutant-->
    <Add mover_name="mutant"/>
    <Add mover_name="relax"/>
  </PROTOCOLS>

  <OUTPUT scorefxn="beta_sf"/>
</ROSETTASCRIPTS>

