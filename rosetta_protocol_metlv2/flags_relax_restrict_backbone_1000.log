		</MoveMapFactory>
	</MOVE_MAP_FACTORIES>
	<MOVERS>
		<MutateResidue name="mutant" new_res="ALA" target="55A"/>
		<FastRelax cartesian="true" disable_design="true" movemap_factory="local_mm" name="relax" repeats="10" scorefxn="beta_sf"/>
	</MOVERS>
	<PROTOCOLS>
		<Add mover_name="mutant"/>
		<Add mover_name="relax"/>
	</PROTOCOLS>
	<OUTPUT scorefxn="beta_sf"/>
</ROSETTASCRIPTS>
