<ROSETTASCRIPTS>
  <SCOREFXNS>
    <ScoreFunction name="beta_sf" weights="beta_nov16"/>
  </SCOREFXNS>

  <RESIDUE_SELECTORS>
    <Neighborhood name="surrounding_move_map" resnums="1A,2A,3A,4A,5A,6A,7A,8A,9A,10A,11A,12A,13A,14A,15A,16A,17A,18A,19A,20A,21A,22A,23A,24A,25A,26A,27A,28A,29A,30A,31A,32A,33A,34A,35A,36A,37A,38A,39A,40A,41A,42A,43A,44A,45A,46A,47A,48A,49A,50A,51A,52A,53A,54A,55A,56A,57A,58A,59A,60A,61A,62A,63A,64A,65A,66A,67A,68A,69A,70A,71A,72A,73A,74A,75A" distance="10000.0"/>
    <Not name="rest_move_map" selector="surrounding_move_map"/>

    <Neighborhood name="surrounding_repack" resnums="1A,2A,3A,4A,5A,6A,7A,8A,9A,10A,11A,12A,13A,14A,15A,16A,17A,18A,19A,20A,21A,22A,23A,24A,25A,26A,27A,28A,29A,30A,31A,32A,33A,34A,35A,36A,37A,38A,39A,40A,41A,42A,43A,44A,45A,46A,47A,48A,49A,50A,51A,52A,53A,54A,55A,56A,57A,58A,59A,60A,61A,62A,63A,64A,65A,66A,67A,68A,69A,70A,71A,72A,73A,74A,75A" distance="10000.0"/>
    <Not name="rest_repack" selector="surrounding_repack"/>

  </RESIDUE_SELECTORS>




  <TASKOPERATIONS>
    <InitializeFromCommandline name="init"/>

    <OperateOnResidueSubset name="repack_res" selector="surrounding_repack">
      <RestrictToRepackingRLT/>
    </OperateOnResidueSubset>
    <OperateOnResidueSubset name="no_repack" selector="rest_repack">
      <PreventRepackingRLT/>
    </OperateOnResidueSubset>
  </TASKOPERATIONS>



  <MOVE_MAP_FACTORIES>
    <!-- allow backbone and sidechain minimization only for residues in "surrounding" -->
    <MoveMapFactory name="local_mm" bb="0" chi="0">
      <Backbone residue_selector="surrounding_move_map" enable="true"/>
      <Chi residue_selector="surrounding_move_map" enable="true"/>
    </MoveMapFactory>
  </MOVE_MAP_FACTORIES>



  <MOVERS>
    <!-- take residue 55 in chain A and mutate it to an Alanine (A)-->

     
 
    <FastRelax name="relax"
               scorefxn="beta_sf"
               disable_design="true"
               task_operations="init,repack_res,no_repack"
               repeats="5"
               movemap_factory="local_mm"/>
  </MOVERS>

  <PROTOCOLS>
    <!-- make sure to add a new mover for each new mutant-->
     
 
    <Add mover_name="relax"/>
  </PROTOCOLS>

  <OUTPUT scorefxn="beta_sf"/>
</ROSETTASCRIPTS>

