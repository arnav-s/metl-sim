<ROSETTASCRIPTS>
  <SCOREFXNS>
    <ScoreFunction name="beta_sf" weights="beta_nov16_cart"/>
  </SCOREFXNS>

  <TASKOPERATIONS>
    <ReadResfile name="mutation_task" filename="mutation.resfile"/>
  </TASKOPERATIONS>

  <MOVERS>
    <!-- attach the MoveMapFactory to FastRelax     -->
    <FastRelax name="mutate_relax"
               scorefxn="beta_sf"
               task_operations="mutation_task"
               disable_design="false"
               cartesian="true"
               repeats="10"
             />
  </MOVERS>

  <PROTOCOLS>
    <Add mover="mutate_relax"/>
  </PROTOCOLS>

  <OUTPUT scorefxn="beta_sf"/>
</ROSETTASCRIPTS>
