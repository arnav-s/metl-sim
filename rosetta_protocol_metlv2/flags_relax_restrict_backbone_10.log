<ROSETTASCRIPTS>
	<SCOREFXNS>
		<ScoreFunction name="beta_sf" weights="beta_nov16_cart"/>
	</SCOREFXNS>
	<RESIDUE_SELECTORS>
		<Neighborhood distance="10" name="surrounding" resnums="55"/>
		<Not name="rest" selector="surrounding"/>
	</RESIDUE_SELECTORS>
	<MOVE_MAP_FACTORIES>
		<MoveMapFactory bb="0" chi="0" name="local_mm">
			<Backbone enable="true" residue_selector="surrounding"/>
			<Chi enable="true" residue_selector="surrounding"/>
		</MoveMapFactory>
	</MOVE_MAP_FACTORIES>
	<MOVERS>
		<MutateResidue name="mutant" new_res="ALA" target="55A"/>
		<FastRelax cartesian="true" disable_design="true" movemap_factory="local_mm" name="relax" repeats="10" scorefxn="beta_sf"/>
	</MOVERS>
	<PROTOCOLS>
		<Add mover_name="mutant"/>
		<Add mover_name="relax"/>
	</PROTOCOLS>
	<OUTPUT scorefxn="beta_sf"/>
</ROSETTASCRIPTS>
